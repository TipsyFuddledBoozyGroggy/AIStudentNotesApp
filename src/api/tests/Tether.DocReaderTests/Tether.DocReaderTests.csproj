<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the DOCX reader. No database, no network, no files: every fixture is generated in memory at test time. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tether.DocReader\Tether.DocReader.csproj" />
  </ItemGroup>
</Project>
