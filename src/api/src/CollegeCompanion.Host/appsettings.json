{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "DevLogin": { "Enabled": false }
  },
  "Security": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
