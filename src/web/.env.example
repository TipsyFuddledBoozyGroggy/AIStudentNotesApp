# No secrets belong here. Placeholders only.
# Mock REST contract via MSW (default for `npm run dev`, see .env.development).
NEXT_PUBLIC_API_MOCKING=enabled
# Same-origin API base path (ADR-006).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# When the real backend exists: proxy /api to it and turn mocking off.
# API_PROXY_TARGET=http://localhost:5000
