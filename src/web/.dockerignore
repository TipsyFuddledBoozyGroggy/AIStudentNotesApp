# Build context for src/web/Dockerfile. Dependencies are installed fresh in the image (npm ci), never copied from the host.
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
e2e/
e2e-harness/
e2e-screens/
playwright*.config.ts
*.tsbuildinfo
npm-debug.log*
# Env files: a production build must not pick up local values (.env.development turns MSW mocking on).
.env
.env.*
**/*.pem
**/*.key
Dockerfile
.dockerignore
