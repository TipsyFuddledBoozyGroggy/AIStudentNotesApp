  "circuitBreaker": {
    "windowMinutes": 10,
    "minConnections": 20,
    "maxTerminalFailurePercent": 5,
    "action": "stop_deleting_and_alert",
    "status": "PROPOSAL"
  },
  "limits": {
    "status": "PROPOSAL pending devops/PO (PO-10q)",
    "googleRequestsPerUserPerMinute": 120,
    "googleWritesPerSecondPerCalendar": 3,
    "googleWritesPerUserPerDay": 3000,
    "runsPerUserPerDay": 20,
    "scheduleWritePerUserPerMinute": 20,
    "schedulePreviewPerUserPerMinute": 30,
    "exportPerUserPerMinute": 6,
    "egressFairness": "per_user_weighted_round_robin",
    "globalStop": {
      "behaviour": "shed_heaviest_users_first",
      "disablesCalendarForEveryone": false,
      "alertAtPercentOfBillingThreshold": 50,
      "softLimitBelowBillingThreshold": true
    },
    "budgetExhaustedResponse": "429 rate_limited with Retry-After",
    "auth": {
      "startPerIpPerMinute": 300,
      "startPerBinderCookiePerMinute": 10,
      "callbackPerIpPerMinute": 300,
      "maxUnconsumedStatesPerIpOrCookie": 20,
      "stateTtlMinutes": 10,
      "rejectBeforeAnyDatabaseWrite": true,
      "copyOn429": "calm_try_again_in_a_moment"
    }
  },
  "retention": {
    "syncRunsPerSyllabus": 20,
    "auditDays": 400,
    "status": "PROPOSAL (PO-10h), configurable"
  },
  "contentFreeEventRecord": {
    "fields": [
      "calendarTargetId",
      "eventId",
      "generation",
      "lastUsedAt"
    ],
    "upperLimitDays": 400,
    "deletedOn": [
      "disconnect",
      "account_deletion",
      "calendar_target_deletion"
    ],
    "status": "PROPOSAL pending PO (PO-9o, PO-10h)",
    "purpose": "A re-created event never reuses a deleted event's id; no title, date, course, item key or fingerprint is kept."
  },
  "hardDeleteOn": [
    "syllabus_delete",
    "course_delete",
    "course_archive",
    "account_deletion",
    "disconnect_keep"
  ],
  "disconnecting": {
    "deadlineHours": 24,
    "exits": [
      "not_connected_on_terminal_token_failure",
      "not_connected_on_student_choosing_keep",
      "not_connected_on_deadline"
    ]
  },
  "accountDeletion": {
    "blocksOnGoogle": false,
    "googleAttemptSeconds": 300
  },
  "previewDigest": {
    "hkdfLabel": "calendar-preview-digest.v1",
    "keyRing": true,
    "canonicalForm": "length_prefixed_utf8",
    "compare": "CryptographicOperations.FixedTimeEquals",
    "stored": false,
    "role": "consistency_check_not_authorisation",
    "binds": [
      "version",
      "userId",
      "kind",
      "syllabusId",
      "connectionId",
      "remoteCalendarId",
      "destination",
      "preset",
      "reminderTime",
      "pause",
      "courseOverrides",
      "entries",
      "generation",
      "reminders",
      "exclusions",
      "leftAlone",
      "skippedReminders",
      "counts"
    ]
  },
  "eventBodyAllowlist": [
    "id",
    "summary",
    "description",
    "start",
    "end",
    "reminders",
    "extendedProperties.private",
    "status"
  ],
  "eventBodyForbidden": [
    "attendees",
    "conferenceData",
    "attachments",
    "source",
    "guestsCanModify",
    "location",
    "colorId",
    "visibility_shared"
  ],
  "sendUpdates": "none",
  "descriptionLink": "no_query_no_ids",
  "dialogsMustState": [
    "events_remain_in_google",
    "also_remove_from_google_choice",
    "next_sign_in_asks_consent_again"
  ]
}
