{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/calendar.v1/calendar-reminder-update-request.schema.json",
  "title": "reminder update request",
  "description": "POST reminder-updates (202), Idempotency-Key required. The only way existing Google events get different reminders, so a settings save never writes to Google. courseId null = all courses. basis restates the reminder settings the preview was computed from; any difference from the server's current settings or plan is 409 plan_changed (CV-08). Events the student edited are skipped. DRAFT calendar.v1 (docs/API_CONTRACTS_CALENDAR.md), NOT frozen. Mock and fake-Google only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "courseId",
    "basis",
    "previewDigest",
    "confirm"
  ],
  "properties": {
    "courseId": {
      "oneOf": [
        {
          "$ref": "calendar-common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "reminderTime",
        "courseOverrides",
        "pausedUntil"
      ],
      "properties": {
        "preset": {
          "$ref": "calendar-common.schema.json#/$defs/reminderPreset"
        },
        "reminderTime": {
          "$ref": "calendar-common.schema.json#/$defs/reminderTime"
        },
        "courseOverrides": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "$ref": "calendar-common.schema.json#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "calendar-common.schema.json#/$defs/courseReminderSetting"
          }
        },
        "pausedUntil": {
          "oneOf": [
            {
              "$ref": "calendar-common.schema.json#/$defs/localDate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "previewDigest": {
      "$ref": "calendar-common.schema.json#/$defs/sha256Hex"
    },
    "confirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination",
        "entryCount",
        "acknowledged"
      ],
      "properties": {
        "destination": {
          "const": "google"
        },
        "entryCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "acknowledged": {
          "const": true
        }
      }
    }
  }
}
