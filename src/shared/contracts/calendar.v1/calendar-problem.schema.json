{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/calendar.v1/calendar-problem.schema.json",
  "title": "calendar problem",
  "description": "RFC 9457 ProblemDetails as in syllabus.v1, with the calendar code additions. DRAFT calendar.v1 (docs/API_CONTRACTS_CALENDAR.md), NOT frozen. Mock and fake-Google only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "code",
    "traceId"
  ],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^https://errors\\.tether\\.invalid/[a-z_]+(?![\\s\\S])"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f]*(?![\\s\\S])",
      "description": "Fixed string per code; never Google error text, exception text or an email address."
    },
    "instance": {
      "type": "string",
      "maxLength": 256
    },
    "code": {
      "$ref": "calendar-common.schema.json#/$defs/errorCode"
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "errors": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "string",
          "maxLength": 200
        }
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.\\[\\]-]{0,63}(?![\\s\\S])"
      }
    },
    "retryAfterSeconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}
