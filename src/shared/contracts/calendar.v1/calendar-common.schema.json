{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/calendar.v1/calendar-common.schema.json",
  "title": "Shared definitions for calendar.v1",
  "description": "DRAFT calendar.v1 (docs/API_CONTRACTS_CALENDAR.md), NOT frozen. Mock and fake-Google only.",
  "$defs": {
    "id": {
      "description": "Opaque server-assigned id, identical to syllabus.v1 (crs_, syl_, itm_) plus ent_ (schedule entry) and run_ (run). One canonical lowercase form; anything else is 400. Clients must not parse ids.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:[a-z]{3}_)?[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "itemKey": {
      "description": "Stable sync key: \"ik_\" + first 32 chars of base64url(SHA-256(UTF-8(\"tether.syllabus.item.v1\\n\" + syllabusId + \"\\n\" + itemId))). Provider-agnostic; never changes when the item is edited.",
      "type": "string",
      "pattern": "^ik_[A-Za-z0-9_-]{32}(?![\\s\\S])"
    },
    "timestamp": {
      "description": "RFC 3339 with offset. Instants only (created/updated/synced); never used for dates the student reads.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "localDate": {
      "description": "Wall-clock calendar date YYYY-MM-DD, years 2000-2100 only (shape and window; calendar validity such as Feb 30 and the term window are server rules, section 2.3).",
      "type": "string",
      "pattern": "^(20[0-9]{2}|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(?![\\s\\S])"
    },
    "localTime": {
      "description": "Wall-clock time HH:MM, 24 hour, no seconds, no offset.",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](?![\\s\\S])"
    },
    "ianaZone": {
      "description": "IANA zone id of the Area/Location form. Offsets such as -05:00, abbreviations such as EST and bare UTC are not accepted. Membership in the server allow-list is a server test.",
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+-]+){1,2}(?![\\s\\S])"
    },
    "etag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "editableKind": {
      "description": "Every kind except policy. policy is AI-assigned and informational only.",
      "type": "string",
      "enum": [
        "assignment",
        "exam",
        "reading",
        "office_hours",
        "other"
      ]
    },
    "itemKind": {
      "type": "string",
      "enum": [
        "assignment",
        "exam",
        "reading",
        "office_hours",
        "policy",
        "other"
      ]
    },
    "flag": {
      "type": "string",
      "enum": [
        "year_inferred",
        "relative_date",
        "timezone_assumed",
        "time_missing",
        "conflicting_sources",
        "tentative_language",
        "table_layout_risk",
        "section_ambiguous",
        "range_end_inferred",
        "weekday_mismatch",
        "date_not_verifiable",
        "until_from_term",
        "low_text_quality",
        "duplicate_candidate",
        "outside_term",
        "dst_ambiguous",
        "injection_suspect",
        "supersession_cue"
      ]
    },
    "timezoneSource": {
      "type": "string",
      "enum": [
        "stated_in_source",
        "course_default",
        "student"
      ]
    },
    "title": {
      "description": "TextPolicy single-line text (API_CONTRACTS_P2 section 2.2). This pattern is a coarse FIRST FILTER (no trailing newline, no controls, format characters, bidi, variation selectors, fillers, braille blank, private use or lone surrogates, no Unicode whitespace other than a single U+0020, no leading/trailing/whole-value whitespace, ZWNJ/ZWJ only between non-space characters, no stray leading mark or more than 4 combining marks); the server TextPolicy is authoritative and defined by Unicode general category. At most 200 Unicode code points (the server enforces the code-point cap; maxLength is a validator-dependent loose upper bound). Stored as plain text; escaped at each sink.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\u200c\\u200d\\u0300-\\u036f\\u1ab0-\\u1aff\\u1dc0-\\u1dff\\u20d0-\\u20ff\\ufe20-\\ufe2f\\ufe0e\\ufe0f])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\u200c\\u200d](?![\\s\\S]))(?![\\s\\S]*[\\u0300-\\u036f\\u1ab0-\\u1aff\\u1dc0-\\u1dff\\u20d0-\\u20ff\\ufe20-\\ufe2f]{5})(?![\\s\\S]*[\\u200c\\u200d][\\u200c\\u200d \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000][\\u200c\\u200d\\u0300-\\u036f\\u1ab0-\\u1aff\\u1dc0-\\u1dff\\u20d0-\\u20ff\\ufe20-\\ufe2f])(?![\\s\\S]*[\\u0020-\\u0022\\u0024-\\u0029\\u002b-\\u002f\\u003a-\\u007e\\u200c\\u200d\\ufe0e\\ufe0f][\\ufe0e\\ufe0f])(?![\\s\\S]*  )(?:[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u034f\\u061c\\u115f\\u1160\\u180b-\\u180f\\u200b\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u206f\\u2800\\u3164\\ufe00-\\ufe0d\\ufeff\\uffa0\\ufff0-\\uffff\\ue000-\\uf8ff\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000\\ud800-\\udfff]|(?:(?!\\ud834[\\udd73-\\udd7a]|\\ud82f[\\udca0-\\udca3]|\\ud80d[\\udc30-\\udc3f]|\\ud804[\\udcbd\\udccd])[\\ud800-\\udb3f\\udb41-\\udb7f][\\udc00-\\udfff]))+(?![\\s\\S])"
    },
    "textLine": {
      "description": "TextPolicy single-line text for short document-derived or server-written strings (confidenceReason, written.dateText/timeText); same coarse first filter as title.",
      "type": "string",
      "pattern": "^(?![ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\u200c\\u200d\\u0300-\\u036f\\u1ab0-\\u1aff\\u1dc0-\\u1dff\\u20d0-\\u20ff\\ufe20-\\ufe2f\\ufe0e\\ufe0f])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\u200c\\u200d](?![\\s\\S]))(?![\\s\\S]*[\\u0300-\\u036f\\u1ab0-\\u1aff\\u1dc0-\\u1dff\\u20d0-\\u20ff\\ufe20-\\ufe2f]{5})(?![\\s\\S]*[\\u200c\\u200d][\\u200c\\u200d \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])(?![\\s\\S]*[ \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000][\\u200c\\u200d\\u0300-\\u036f\\u1ab0-\\u1aff\\u1dc0-\\u1dff\\u20d0-\\u20ff\\ufe20-\\ufe2f])(?![\\s\\S]*[\\u0020-\\u0022\\u0024-\\u0029\\u002b-\\u002f\\u003a-\\u007e\\u200c\\u200d\\ufe0e\\ufe0f][\\ufe0e\\ufe0f])(?![\\s\\S]*  )(?:[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u034f\\u061c\\u115f\\u1160\\u180b-\\u180f\\u200b\\u200e\\u200f\\u2028-\\u202e\\u2060-\\u206f\\u2800\\u3164\\ufe00-\\ufe0d\\ufeff\\uffa0\\ufff0-\\uffff\\ue000-\\uf8ff\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000\\ud800-\\udfff]|(?:(?!\\ud834[\\udd73-\\udd7a]|\\ud82f[\\udca0-\\udca3]|\\ud80d[\\udc30-\\udc3f]|\\ud804[\\udcbd\\udccd])[\\ud800-\\udb3f\\udb41-\\udb7f][\\udc00-\\udfff]))+(?![\\s\\S])"
    },
    "idempotencyKey": {
      "description": "Idempotency-Key header value: 8-128 URL-safe characters, no trailing newline. Anything else is 400 validation_failed.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}(?![\\s\\S])"
    },
    "syncState": {
      "type": "string",
      "enum": [
        "not_synced",
        "synced",
        "changed_since_sync",
        "sync_failed"
      ]
    },
    "noticeVersion": {
      "description": "Id of the DRAFT upload notice shown to the student (wording is a Product Owner / counsel placeholder, P2-D5). Opaque; the server checks it against the notice versions it knows.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "errorCode": {
      "description": "lecture.v1 ProblemDetails codes plus calendar codes (docs/API_CONTRACTS_CALENDAR.md section 7). Provider/Google detail never appears.",
      "type": "string",
      "enum": [
        "validation_failed",
        "unauthenticated",
        "csrf_failed",
        "not_found",
        "invalid_state",
        "concurrency_conflict",
        "precondition_required",
        "precondition_failed",
        "rate_limited",
        "provider_unavailable",
        "connection_required",
        "destination_not_chosen",
        "plan_changed",
        "run_in_progress"
      ]
    },
    "entryErrorCode": {
      "description": "Per-item codes inside 200/202 run results. left_alone_* accompany outcome left_alone and nothing else.",
      "type": "string",
      "enum": [
        "item_needs_date",
        "item_not_syncable",
        "item_not_approved",
        "precondition_failed",
        "not_found",
        "provider_unavailable",
        "invalid_state",
        "event_limit_reached",
        "connection_required",
        "provider_rate_limited",
        "remote_rejected",
        "remote_conflict",
        "left_alone_edited",
        "left_alone_deleted"
      ]
    },
    "destination": {
      "description": "Where the student's schedule lives (PO-9i): Tether's own calendar, or ONE Tether-created Google calendar.",
      "type": "string",
      "enum": [
        "tether",
        "google"
      ]
    },
    "settingsDestination": {
      "description": "unset until the student chooses. No preview or write is possible while unset (409 destination_not_chosen).",
      "type": "string",
      "enum": [
        "unset",
        "tether",
        "google"
      ]
    },
    "reminderPreset": {
      "description": "docs/ux/calendar-reminders.md section 2. Gentle is the pre-selected default (PO-9l).",
      "type": "string",
      "enum": [
        "off",
        "gentle",
        "extra_runway"
      ]
    },
    "courseReminderSetting": {
      "type": "string",
      "enum": [
        "use_default",
        "off",
        "gentle",
        "extra_runway"
      ]
    },
    "reminderTime": {
      "description": "Time of day day-based reminders fire (local). 08:00 to 20:00 on the hour: no reminder is planned 21:00-08:00. Default 09:00.",
      "type": "string",
      "pattern": "^(0[89]|1[0-9]|20):00(?![\\s\\S])"
    },
    "reminder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minutesBefore",
        "method"
      ],
      "properties": {
        "minutesBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40320,
          "description": "Google range 0..40320 (4 weeks)."
        },
        "method": {
          "const": "popup"
        }
      }
    },
    "entryReminders": {
      "description": "Max 3 per event (Extra runway); Google allows 5. Always empty on the Tether calendar (Tether sends no notifications).",
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "calendar-common.schema.json#/$defs/reminder"
      }
    },
    "entryState": {
      "description": "scheduled: exists on its destination. retry_later: a Google write is waiting for a retry. removal_pending: removal confirmed, remote delete not yet confirmed. deleted_in_google: the student deleted it in Google; Tether leaves it alone and never recreates it (PO-9a). edited_in_google: the student changed it in Google; Tether stops managing it and never overwrites or removes it (PO-10a). There is no detached state: when a syllabus, course or account is deleted, or Google is disconnected, the entry row is hard-deleted and only a content-free per-event record (event id plus generation) may remain (PO-9o option C).",
      "type": "string",
      "enum": [
        "scheduled",
        "retry_later",
        "removal_pending",
        "deleted_in_google",
        "edited_in_google"
      ]
    },
    "connectionStatus": {
      "type": "string",
      "enum": [
        "not_connected",
        "connected",
        "needs_reauth",
        "admin_blocked",
        "disconnecting"
      ]
    },
    "calendarState": {
      "type": "string",
      "enum": [
        "not_created",
        "ready",
        "missing_in_google"
      ]
    },
    "eventsAction": {
      "description": "keep (default): events stay in Google, Tether forgets nothing it needs and stops managing them. remove_events: delete only entries Tether wrote and the student did not edit.",
      "type": "string",
      "enum": [
        "keep",
        "remove_events"
      ]
    },
    "runKind": {
      "description": "resume: the deliberate, previewed re-add of a deleted event or take-back of an edited one (PO-10e, PO-10o). Moving entries between destinations (PO-10d) is a separate confirmed run reserved for a later revision.",
      "type": "string",
      "enum": [
        "write",
        "remove",
        "reminders",
        "resume"
      ]
    },
    "actionPreviewKind": {
      "type": "string",
      "enum": [
        "removal",
        "reminders",
        "disconnect",
        "resume"
      ]
    },
    "revocation": {
      "description": "Whether Google confirmed revocation at disconnect. unconfirmed: the student is told to remove Tether in their Google account settings.",
      "type": "string",
      "enum": [
        "confirmed",
        "unconfirmed"
      ]
    },
    "resumeAction": {
      "description": "readd: create a deleted event again under the next generation. take_back: overwrite the student's edit with the syllabus version.",
      "type": "string",
      "enum": [
        "readd",
        "take_back"
      ]
    },
    "runState": {
      "type": "string",
      "enum": [
        "planned",
        "executing",
        "succeeded",
        "partial",
        "failed",
        "nothing_to_do",
        "cancelled"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "unchanged",
        "removed",
        "not_present",
        "left_alone",
        "retrying",
        "failed",
        "not_eligible"
      ]
    },
    "previewAction": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "unchanged"
      ]
    },
    "skippedReminderReason": {
      "type": "string",
      "enum": [
        "daily_cap",
        "already_past",
        "too_close",
        "beyond_google_limit",
        "quiet_hours",
        "course_off",
        "paused"
      ]
    },
    "excludedReason": {
      "type": "string",
      "enum": [
        "needs_date",
        "not_approved",
        "policy",
        "revision_changed",
        "not_found",
        "event_limit_reached"
      ]
    },
    "leftAloneReason": {
      "type": "string",
      "enum": [
        "edited_in_google",
        "deleted_in_google"
      ]
    },
    "callbackOutcome": {
      "description": "Opaque outcome code appended to the post-callback redirect. Never carries a code, token, email or Google error text.",
      "type": "string",
      "enum": [
        "signed_in",
        "connected",
        "access_denied",
        "account_mismatch",
        "scope_missing",
        "scope_unexpected",
        "admin_blocked",
        "state_invalid",
        "provider_unavailable"
      ]
    },
    "googleScope": {
      "description": "Granted-scope vocabulary. calendar.app.created is the only data scope (PO-9h). Any other scope string is an error.",
      "type": "string",
      "enum": [
        "openid",
        "email",
        "profile",
        "calendar.app.created"
      ]
    },
    "maskedEmail": {
      "description": "First character, three asterisks, domain. Display only; never an identifier.",
      "type": "string",
      "pattern": "^[A-Za-z0-9]\\*\\*\\*@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?![\\s\\S])",
      "maxLength": 100
    },
    "authorizationUrl": {
      "description": "Server-built Google authorization URL (state, nonce, S256 challenge inside). Host and path are fixed; the contract tests parse the query.",
      "type": "string",
      "pattern": "^https://accounts\\.google\\.com/o/oauth2/v2/auth\\?[A-Za-z0-9._~%&=+:/-]{40,2000}(?![\\s\\S])"
    },
    "landing": {
      "description": "Post-callback landing route key. A key, never a URL: no open redirect.",
      "type": "string",
      "enum": [
        "home",
        "schedule"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "confirmWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination",
        "entryCount",
        "reminderPreset",
        "acknowledged"
      ],
      "properties": {
        "destination": {
          "$ref": "calendar-common.schema.json#/$defs/destination"
        },
        "entryCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Must equal the previewed create+update count (the button text says it)."
        },
        "reminderPreset": {
          "oneOf": [
            {
              "$ref": "calendar-common.schema.json#/$defs/reminderPreset"
            },
            {
              "type": "null"
            }
          ]
        },
        "acknowledged": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "destination": {
                "const": "tether"
              }
            },
            "required": [
              "destination"
            ]
          },
          "then": {
            "properties": {
              "reminderPreset": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "destination": {
                "const": "google"
              }
            },
            "required": [
              "destination"
            ]
          },
          "then": {
            "properties": {
              "reminderPreset": {
                "$ref": "calendar-common.schema.json#/$defs/reminderPreset"
              }
            }
          }
        }
      ]
    },
    "confirmCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination",
        "entryCount",
        "acknowledged"
      ],
      "properties": {
        "destination": {
          "$ref": "calendar-common.schema.json#/$defs/destination"
        },
        "entryCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "acknowledged": {
          "const": true
        }
      }
    },
    "startLocal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "time",
        "timezone"
      ],
      "properties": {
        "date": {
          "$ref": "calendar-common.schema.json#/$defs/localDate"
        },
        "time": {
          "oneOf": [
            {
              "$ref": "calendar-common.schema.json#/$defs/localTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "$ref": "calendar-common.schema.json#/$defs/ianaZone"
        }
      }
    },
    "endLocal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "time"
      ],
      "properties": {
        "date": {
          "$ref": "calendar-common.schema.json#/$defs/localDate"
        },
        "time": {
          "oneOf": [
            {
              "$ref": "calendar-common.schema.json#/$defs/localTime"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "eventTimes": {
      "description": "Shared all-day / timed rule: all-day has no times and no derived end; timed has both. end.date is INCLUSIVE here (as syllabus.v1); the Google adapter converts to Google's exclusive all-day end.",
      "allOf": [
        {
          "if": {
            "properties": {
              "allDay": {
                "const": true
              }
            },
            "required": [
              "allDay"
            ]
          },
          "then": {
            "properties": {
              "start": {
                "properties": {
                  "time": {
                    "type": "null"
                  }
                }
              },
              "end": {
                "properties": {
                  "time": {
                    "type": "null"
                  }
                }
              },
              "endDerived": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allDay": {
                "const": false
              }
            },
            "required": [
              "allDay"
            ]
          },
          "then": {
            "properties": {
              "start": {
                "properties": {
                  "time": {
                    "$ref": "calendar-common.schema.json#/$defs/localTime"
                  }
                }
              },
              "end": {
                "properties": {
                  "time": {
                    "$ref": "calendar-common.schema.json#/$defs/localTime"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
