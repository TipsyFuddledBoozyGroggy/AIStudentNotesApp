{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/calendar.v1/calendar-run.schema.json",
  "title": "schedule run",
  "description": "A write, removal, reminder-update or resume run. Every kind carries the previewDigest it was confirmed against (stored with the confirm, item revisions and the SERVER receipt time). 202 on creation; poll GET runs/{runId}. State machine in docs/API_CONTRACTS_CALENDAR.md section 9. results is per item (empty for reminders runs and for runs without an item scope). A replay of the same Idempotency-Key returns the original body with Idempotency-Replayed: true. DRAFT calendar.v1 (docs/API_CONTRACTS_CALENDAR.md), NOT frozen. Mock and fake-Google only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "kind",
    "syllabusId",
    "destination",
    "state",
    "createdAt",
    "startedAt",
    "finishedAt",
    "progress",
    "results",
    "counts",
    "previewDigest"
  ],
  "properties": {
    "runId": {
      "$ref": "calendar-common.schema.json#/$defs/id"
    },
    "kind": {
      "$ref": "calendar-common.schema.json#/$defs/runKind"
    },
    "syllabusId": {
      "oneOf": [
        {
          "$ref": "calendar-common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "$ref": "calendar-common.schema.json#/$defs/destination"
    },
    "state": {
      "$ref": "calendar-common.schema.json#/$defs/runState"
    },
    "createdAt": {
      "$ref": "calendar-common.schema.json#/$defs/timestamp"
    },
    "startedAt": {
      "oneOf": [
        {
          "$ref": "calendar-common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "finishedAt": {
      "oneOf": [
        {
          "$ref": "calendar-common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "done"
      ],
      "properties": {
        "total": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        },
        "done": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "itemKey",
          "outcome",
          "errorCode",
          "entryCount",
          "syncState"
        ],
        "properties": {
          "itemId": {
            "$ref": "calendar-common.schema.json#/$defs/id"
          },
          "itemKey": {
            "$ref": "calendar-common.schema.json#/$defs/itemKey"
          },
          "outcome": {
            "$ref": "calendar-common.schema.json#/$defs/outcome"
          },
          "errorCode": {
            "oneOf": [
              {
                "$ref": "calendar-common.schema.json#/$defs/entryErrorCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "entryCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "syncState": {
            "$ref": "calendar-common.schema.json#/$defs/syncState"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "left_alone"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "errorCode": {
                  "enum": [
                    "left_alone_edited",
                    "left_alone_deleted"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "not": {
                    "const": "left_alone"
                  }
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "errorCode": {
                  "not": {
                    "enum": [
                      "left_alone_edited",
                      "left_alone_deleted"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "updated",
        "unchanged",
        "removed",
        "notPresent",
        "leftAlone",
        "retrying",
        "failed",
        "notEligible"
      ],
      "properties": {
        "created": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        },
        "updated": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        },
        "unchanged": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        },
        "removed": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        },
        "notPresent": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        },
        "leftAlone": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        },
        "retrying": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        },
        "failed": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        },
        "notEligible": {
          "$ref": "calendar-common.schema.json#/$defs/count"
        }
      }
    },
    "previewDigest": {
      "$ref": "calendar-common.schema.json#/$defs/sha256Hex"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "planned"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "startedAt": {
            "type": "null"
          },
          "finishedAt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "executing"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "startedAt": {
            "$ref": "calendar-common.schema.json#/$defs/timestamp"
          },
          "finishedAt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "succeeded",
              "partial",
              "failed",
              "nothing_to_do",
              "cancelled"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "finishedAt": {
            "$ref": "calendar-common.schema.json#/$defs/timestamp"
          },
          "counts": {
            "properties": {
              "retrying": {
                "const": 0
              }
            }
          },
          "results": {
            "items": {
              "properties": {
                "outcome": {
                  "not": {
                    "const": "retrying"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reminders"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "write",
              "resume"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "syllabusId": {
            "$ref": "calendar-common.schema.json#/$defs/id"
          }
        }
      }
    }
  ]
}
