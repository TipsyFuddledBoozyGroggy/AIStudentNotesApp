{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/syllabus.v1/syllabus-calendar-sync-result.schema.json",
  "title": "calendar sync result",
  "description": "200 for all outcomes. A replay of the same Idempotency-Key returns this body as originally produced with Idempotency-Replayed: true; current item state may differ (a later skip or edit is not reflected in the replayed body).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "syncId",
    "syllabusId",
    "provider",
    "demoCalendar",
    "status",
    "completedAt",
    "results",
    "counts"
  ],
  "properties": {
    "syncId": {
      "$ref": "syllabus-common.schema.json#/$defs/id"
    },
    "syllabusId": {
      "$ref": "syllabus-common.schema.json#/$defs/id"
    },
    "provider": {
      "const": "mock"
    },
    "demoCalendar": {
      "const": true
    },
    "status": {
      "type": "string",
      "enum": [
        "all_succeeded",
        "partial",
        "failed",
        "nothing_to_do"
      ]
    },
    "completedAt": {
      "$ref": "syllabus-common.schema.json#/$defs/timestamp"
    },
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "itemKey",
          "outcome",
          "errorCode",
          "eventCount",
          "syncState"
        ],
        "properties": {
          "itemId": {
            "$ref": "syllabus-common.schema.json#/$defs/id"
          },
          "itemKey": {
            "$ref": "syllabus-common.schema.json#/$defs/itemKey"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "updated",
              "unchanged",
              "failed",
              "not_eligible"
            ]
          },
          "errorCode": {
            "oneOf": [
              {
                "$ref": "syllabus-common.schema.json#/$defs/itemErrorCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "eventCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "syncState": {
            "$ref": "syllabus-common.schema.json#/$defs/syncState"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "updated",
        "unchanged",
        "failed",
        "notEligible"
      ],
      "properties": {
        "created": {
          "type": "integer",
          "minimum": 0
        },
        "updated": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "notEligible": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
