{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/syllabus.v1/syllabus-calendar-sync-request.schema.json",
  "title": "calendar sync request",
  "description": "Explicit confirm. Idempotency-Key required. provider is fixed to mock while PO-6 is open.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "itemIds",
    "confirm"
  ],
  "properties": {
    "itemIds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "syllabus-common.schema.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "acknowledgedDemo"
      ],
      "properties": {
        "provider": {
          "const": "mock"
        },
        "acknowledgedDemo": {
          "const": true
        }
      }
    }
  }
}
