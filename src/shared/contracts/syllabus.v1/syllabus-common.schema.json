{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/syllabus.v1/syllabus-common.schema.json",
  "title": "Shared definitions for syllabus.v1",
  "description": "DRAFT v1 (docs/API_CONTRACTS_P2.md). Not frozen.",
  "$defs": {
    "id": {
      "description": "Opaque server-assigned id, same format as lecture.v1 resources (ses_..., crs_...). Prefixes: syl_, itm_, syn_, evt_, unc_.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "itemKey": {
      "description": "Stable sync key: \"ik_\" + first 32 chars of base64url(SHA-256(UTF-8(\"tether.syllabus.item.v1\\n\" + syllabusId + \"\\n\" + itemId))). Provider-agnostic; never changes when the item is edited.",
      "type": "string",
      "pattern": "^ik_[A-Za-z0-9_-]{32}$"
    },
    "timestamp": {
      "description": "RFC 3339 with offset. Instants only (created/updated/synced); never used for dates the student reads.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "localDate": {
      "description": "Wall-clock calendar date YYYY-MM-DD, years 2000-2100 only (shape and window; calendar validity such as Feb 30 and the term window are server rules, section 2.3).",
      "type": "string",
      "pattern": "^(20[0-9]{2}|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "localTime": {
      "description": "Wall-clock time HH:MM, 24 hour, no seconds, no offset.",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "ianaZone": {
      "description": "IANA zone id of the Area/Location form. Offsets such as -05:00, abbreviations such as EST and bare UTC are not accepted. Membership in the server allow-list is a server test.",
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z]+(/[A-Za-z0-9_+-]+){1,2}$"
    },
    "etag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "weekday": {
      "type": "string",
      "enum": [
        "MO",
        "TU",
        "WE",
        "TH",
        "FR",
        "SA",
        "SU"
      ]
    },
    "extractionStatus": {
      "type": "string",
      "enum": [
        "queued",
        "extracting",
        "proposing",
        "ready",
        "needs_text",
        "partial",
        "failed"
      ]
    },
    "statusReason": {
      "type": "string",
      "enum": [
        "no_text_layer",
        "unreadable_file",
        "password_protected",
        "too_long",
        "budget_limited",
        "provider_unavailable",
        "timeout",
        "invalid_output",
        "disabled"
      ]
    },
    "itemKind": {
      "type": "string",
      "enum": [
        "assignment",
        "exam",
        "reading",
        "office_hours",
        "policy",
        "other"
      ]
    },
    "editableKind": {
      "description": "Every kind except policy. policy is AI-assigned and informational only.",
      "type": "string",
      "enum": [
        "assignment",
        "exam",
        "reading",
        "office_hours",
        "other"
      ]
    },
    "confidence": {
      "description": "Server-derived bucket. There is deliberately no numeric score on the wire.",
      "type": "string",
      "enum": [
        "looks_right",
        "probably_right",
        "please_check"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "undecided",
        "approved",
        "skipped"
      ]
    },
    "syncState": {
      "type": "string",
      "enum": [
        "not_synced",
        "synced",
        "changed_since_sync",
        "sync_failed"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "ai",
        "student"
      ]
    },
    "whenStatus": {
      "type": "string",
      "enum": [
        "resolved",
        "needs_date",
        "not_applicable"
      ]
    },
    "derivation": {
      "type": "string",
      "enum": [
        "explicit_full",
        "year_from_term",
        "relative_to_anchor",
        "student_entered"
      ]
    },
    "unknownReason": {
      "type": "string",
      "enum": [
        "not_stated",
        "tba",
        "relative_unresolvable",
        "conflicting",
        "ambiguous_format",
        "table_unreadable",
        "date_not_verifiable"
      ]
    },
    "timezoneSource": {
      "type": "string",
      "enum": [
        "stated_in_source",
        "course_default",
        "student"
      ]
    },
    "flag": {
      "type": "string",
      "enum": [
        "year_inferred",
        "relative_date",
        "timezone_assumed",
        "time_missing",
        "conflicting_sources",
        "tentative_language",
        "table_layout_risk",
        "section_ambiguous",
        "range_end_inferred",
        "weekday_mismatch",
        "date_not_verifiable",
        "until_from_term",
        "low_text_quality",
        "duplicate_candidate",
        "outside_term",
        "dst_ambiguous",
        "injection_suspect",
        "supersession_cue"
      ]
    },
    "precision": {
      "type": "string",
      "enum": [
        "exact",
        "line"
      ]
    },
    "title": {
      "description": "TextPolicy single-line text (API_CONTRACTS_P2 section 2.2): no C0/C1 controls (so no CR, LF, NUL, tab), no U+2028/2029, no bidi marks/overrides/isolates, no zero-width or other format characters, no tag characters, no leading/trailing space, at most 4 consecutive combining marks, at most 200 code points. Stored as plain text; escaped at each sink.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?! )(?!.* $)(?!.*[\\u0300-\\u036f]{5})(?!.*\\uDB40[\\uDC00-\\uDC7F])[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]+$"
    },
    "notes": {
      "description": "TextPolicy multi-line text: LF only (CR rejected), at most 10 lines, same forbidden characters as title otherwise, at most 500 code points. Stored as plain text; escaped at each sink.",
      "type": "string",
      "maxLength": 500,
      "pattern": "^(?!(?:[^\\n]*\\n){10})(?![\\s\\S]*[\\u0300-\\u036f]{5})(?![\\s\\S]*\\uDB40[\\uDC00-\\uDC7F])[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]*$"
    },
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start",
        "end",
        "page",
        "precision",
        "context"
      ],
      "properties": {
        "text": {
          "description": "Sliced by the server from the stored canonical text (TextPolicy applied before storage), never the model string. Untrusted plain text: render as a text node. start/end are UTF-16 code unit offsets.",
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "^(?![\\s\\S]*\\uDB40[\\uDC00-\\uDC7F])[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]+$"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "UTF-16 code unit offset (.NET string index) into the canonical text. Never a code point or byte offset; slicing is done in .NET, never in SQL."
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "$ref": "#/$defs/precision"
        },
        "context": {
          "description": "Server-sliced context window around the snippet (the full line or paragraph, up to 1500 UTF-16 code units, never model text), so the student can judge a verbatim snippet without the original file. Offsets are UTF-16 code units in the same canonical text and context.start <= snippet.start, snippet.end <= context.end. null only after the canonical text has been purged (retention).",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "start",
                "end"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500,
                  "pattern": "^(?![\\s\\S]*\\uDB40[\\uDC00-\\uDC7F])[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]+$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "errorCode": {
      "description": "lecture.v1 ProblemDetails codes plus syllabus codes (docs/API_CONTRACTS_P2.md section 9).",
      "type": "string",
      "enum": [
        "validation_failed",
        "unauthenticated",
        "csrf_failed",
        "not_found",
        "invalid_state",
        "concurrency_conflict",
        "precondition_required",
        "precondition_failed",
        "rate_limited",
        "provider_unavailable",
        "unsupported_type",
        "too_large",
        "duplicate_syllabus",
        "extraction_in_progress",
        "syllabus_limit_reached",
        "item_needs_date",
        "item_not_syncable",
        "item_not_approved",
        "acknowledgement_required",
        "batch_not_eligible",
        "student_item_only"
      ]
    },
    "itemErrorCode": {
      "description": "Per-item failure codes inside 200 batch/sync results.",
      "type": "string",
      "enum": [
        "item_needs_date",
        "item_not_syncable",
        "item_not_approved",
        "batch_not_eligible",
        "acknowledgement_required",
        "precondition_failed",
        "not_found",
        "provider_unavailable",
        "invalid_state",
        "event_limit_reached"
      ]
    },
    "textLine": {
      "description": "TextPolicy single-line text for short document-derived or server-written strings (confidenceReason, written.dateText/timeText).",
      "type": "string",
      "pattern": "^(?! )(?!.* $)(?!.*[\\u0300-\\u036f]{5})(?!.*\\uDB40[\\uDC00-\\uDC7F])[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]+$"
    },
    "noticeVersion": {
      "description": "Id of the DRAFT upload notice shown to the student (wording is a Product Owner / counsel placeholder, P2-D5). Opaque; the server checks it against the notice versions it knows.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "idempotencyKey": {
      "description": "Idempotency-Key header value: 8-128 URL-safe characters. Anything else is 400 validation_failed.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    }
  }
}
