{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/syllabus.v1/syllabus-item-create-request.schema.json",
  "title": "create item request",
  "description": "Student-added item. A date is required: undated student items are not supported in v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "title",
    "date"
  ],
  "properties": {
    "kind": {
      "$ref": "syllabus-common.schema.json#/$defs/editableKind"
    },
    "title": {
      "$ref": "syllabus-common.schema.json#/$defs/title"
    },
    "notes": {
      "oneOf": [
        {
          "$ref": "syllabus-common.schema.json#/$defs/notes"
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "$ref": "syllabus-common.schema.json#/$defs/localDate"
    },
    "endDate": {
      "oneOf": [
        {
          "$ref": "syllabus-common.schema.json#/$defs/localDate"
        },
        {
          "type": "null"
        }
      ]
    },
    "time": {
      "oneOf": [
        {
          "$ref": "syllabus-common.schema.json#/$defs/localTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "endTime": {
      "oneOf": [
        {
          "$ref": "syllabus-common.schema.json#/$defs/localTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "allDay": {
      "type": "boolean"
    },
    "timezone": {
      "$ref": "syllabus-common.schema.json#/$defs/ianaZone"
    }
  }
}
