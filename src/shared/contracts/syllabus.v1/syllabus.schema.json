{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/syllabus.v1/syllabus.schema.json",
  "title": "syllabus",
  "description": "One uploaded or pasted syllabus and its extraction status. The original file is NOT retained (originalRetained is always false, provisional PO decision D4). The canonical extracted text is retained until deletion or the retention purge (section 5.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "courseId",
    "title",
    "inputKind",
    "fileType",
    "status",
    "statusReason",
    "pollAfterSeconds",
    "aiSource",
    "demoSource",
    "demoCalendar",
    "originalRetained",
    "contentSha256",
    "document",
    "unprocessedRanges",
    "context",
    "provenance",
    "counts",
    "etag",
    "createdAt",
    "updatedAt",
    "batchApproveAllowed",
    "notice",
    "retention"
  ],
  "properties": {
    "id": {
      "$ref": "syllabus-common.schema.json#/$defs/id"
    },
    "courseId": {
      "$ref": "syllabus-common.schema.json#/$defs/id"
    },
    "title": {
      "oneOf": [
        {
          "$ref": "syllabus-common.schema.json#/$defs/title"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputKind": {
      "type": "string",
      "enum": [
        "upload",
        "paste"
      ]
    },
    "fileType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "pdf",
            "docx",
            "txt"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "syllabus-common.schema.json#/$defs/extractionStatus"
    },
    "statusReason": {
      "oneOf": [
        {
          "$ref": "syllabus-common.schema.json#/$defs/statusReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "pollAfterSeconds": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "aiSource": {
      "type": "string",
      "enum": [
        "mock",
        "model"
      ]
    },
    "demoSource": {
      "type": "boolean"
    },
    "demoCalendar": {
      "const": true
    },
    "originalRetained": {
      "const": false
    },
    "contentSha256": {
      "$ref": "syllabus-common.schema.json#/$defs/sha256Hex"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageCount",
        "charCount",
        "unreadablePages",
        "hiddenContentRemoved",
        "injectionSuspect",
        "hiddenContentDropped"
      ],
      "properties": {
        "pageCount": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            {
              "type": "null"
            }
          ]
        },
        "charCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "unreadablePages": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "uniqueItems": true
        },
        "hiddenContentRemoved": {
          "type": "integer",
          "minimum": 0
        },
        "injectionSuspect": {
          "type": "boolean"
        },
        "hiddenContentDropped": {
          "description": "True when hidden content (invisible/tiny/off-page/background-colored text, DOCX vanish runs, comments) was removed before any AI saw the text. The count is hiddenContentRemoved.",
          "type": "boolean"
        }
      }
    },
    "unprocessedRanges": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromPage",
          "toPage",
          "reason"
        ],
        "properties": {
          "fromPage": {
            "type": "integer",
            "minimum": 1
          },
          "toPage": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "$ref": "syllabus-common.schema.json#/$defs/statusReason"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termStart",
        "termEnd",
        "defaultTimezone"
      ],
      "properties": {
        "termStart": {
          "oneOf": [
            {
              "$ref": "syllabus-common.schema.json#/$defs/localDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "termEnd": {
          "oneOf": [
            {
              "$ref": "syllabus-common.schema.json#/$defs/localDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "defaultTimezone": {
          "$ref": "syllabus-common.schema.json#/$defs/ianaZone"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extractorVersion",
        "promptVersion",
        "schemaVersion",
        "model"
      ],
      "properties": {
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "promptVersion": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "schemaVersion": {
          "type": "string",
          "maxLength": 64
        },
        "model": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "undecided",
        "approved",
        "skipped",
        "needsDate",
        "synced",
        "droppedInvalid",
        "unclaimedDates"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "undecided": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "approved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "needsDate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "synced": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "droppedInvalid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "unclaimedDates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      }
    },
    "etag": {
      "$ref": "syllabus-common.schema.json#/$defs/etag"
    },
    "createdAt": {
      "$ref": "syllabus-common.schema.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "syllabus-common.schema.json#/$defs/timestamp"
    },
    "batchApproveAllowed": {
      "description": "False when document.injectionSuspect, hiddenContentDropped or any item has low_text_quality: batch approve then returns batch_not_eligible for every item (API_CONTRACTS_P2 section 6.1).",
      "type": "boolean"
    },
    "notice": {
      "description": "Record that the notice was shown and attested at creation (content-free). Wording is a DRAFT placeholder.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "attested",
        "attestedAt"
      ],
      "properties": {
        "version": {
          "$ref": "syllabus-common.schema.json#/$defs/noticeVersion"
        },
        "attested": {
          "const": true
        },
        "attestedAt": {
          "$ref": "syllabus-common.schema.json#/$defs/timestamp"
        }
      }
    },
    "retention": {
      "description": "Canonical text retention (provisional 180 days after last student activity, PO-owned D4/D11). canonicalTextPurgeAt is null once the text has been purged.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalTextPurged",
        "canonicalTextPurgeAt"
      ],
      "properties": {
        "canonicalTextPurged": {
          "type": "boolean"
        },
        "canonicalTextPurgeAt": {
          "oneOf": [
            {
              "$ref": "syllabus-common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "queued",
              "extracting",
              "proposing"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "pollAfterSeconds": {
            "type": "integer"
          },
          "statusReason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "pollAfterSeconds": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "statusReason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_text"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "statusReason": {
            "const": "no_text_layer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "partial",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "statusReason": {
            "$ref": "syllabus-common.schema.json#/$defs/statusReason"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inputKind": {
            "const": "paste"
          }
        },
        "required": [
          "inputKind"
        ]
      },
      "then": {
        "properties": {
          "fileType": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aiSource": {
            "const": "mock"
          }
        },
        "required": [
          "aiSource"
        ]
      },
      "then": {
        "properties": {
          "demoSource": {
            "const": true
          }
        }
      }
    },
    {
      "description": "P2-08: a suspect or hidden-content document never allows batch approve.",
      "if": {
        "anyOf": [
          {
            "properties": {
              "document": {
                "properties": {
                  "injectionSuspect": {
                    "const": true
                  }
                },
                "required": [
                  "injectionSuspect"
                ]
              }
            },
            "required": [
              "document"
            ]
          },
          {
            "properties": {
              "document": {
                "properties": {
                  "hiddenContentDropped": {
                    "const": true
                  }
                },
                "required": [
                  "hiddenContentDropped"
                ]
              }
            },
            "required": [
              "document"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "batchApproveAllowed": {
            "const": false
          }
        }
      }
    },
    {
      "description": "A purged canonical text has no purge date; an unpurged one has.",
      "if": {
        "properties": {
          "retention": {
            "properties": {
              "canonicalTextPurged": {
                "const": true
              }
            },
            "required": [
              "canonicalTextPurged"
            ]
          }
        },
        "required": [
          "retention"
        ]
      },
      "then": {
        "properties": {
          "retention": {
            "properties": {
              "canonicalTextPurgeAt": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "retention": {
            "properties": {
              "canonicalTextPurgeAt": {
                "$ref": "syllabus-common.schema.json#/$defs/timestamp"
              }
            }
          }
        }
      }
    }
  ]
}
