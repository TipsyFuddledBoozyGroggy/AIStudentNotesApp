{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/lecture.v1/session.state.schema.json",
  "title": "session.state",
  "description": "Persisted event: seq is non-null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "sessionId",
    "seq",
    "ts",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "const": "session.state"
    },
    "sessionId": {
      "$ref": "common.schema.json#/$defs/sessionId"
    },
    "seq": {
      "$ref": "common.schema.json#/$defs/seq"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/sessionState"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
