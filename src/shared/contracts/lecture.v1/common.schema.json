{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/lecture.v1/common.schema.json",
  "title": "Shared definitions for lecture.v1 and speech.v1",
  "$defs": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "seq": {
      "description": "Per-session int64 serialized as a decimal string (API_CONTRACTS section 10, C-10/C-27).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "timestamp": {
      "description": "RFC 3339 date-time with offset.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "segmentId": {
      "description": "Server-assigned; meaningful only together with sessionId.",
      "type": "string",
      "pattern": "^seg_[0-9]+$",
      "maxLength": 32
    },
    "ms": {
      "description": "Offset from session start excluding paused time.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "text": {
      "description": "Untrusted plain text (C-28). Length limit is a proposal.",
      "type": "string",
      "maxLength": 4000
    },
    "windowMinutes": {
      "type": "integer",
      "enum": [
        2,
        5,
        10
      ]
    },
    "sessionState": {
      "type": "string",
      "enum": [
        "Active",
        "Paused",
        "Stopped",
        "Failed"
      ]
    },
    "gapReason": {
      "type": "string",
      "enum": [
        "paused",
        "network",
        "device",
        "provider"
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "startMs"
      ],
      "properties": {
        "segmentId": {
          "$ref": "#/$defs/segmentId"
        },
        "startMs": {
          "$ref": "#/$defs/ms"
        }
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "errorCode": {
      "description": "Only codes from the ProblemDetails table (backend-foundation.md section 5; precondition_* expanded to the two codes the server emits).",
      "type": "string",
      "enum": [
        "validation_failed",
        "unauthenticated",
        "consent_required",
        "csrf_failed",
        "not_found",
        "invalid_state",
        "concurrency_conflict",
        "precondition_required",
        "precondition_failed",
        "rate_limited",
        "provider_unavailable"
      ]
    },
    "errorDetail": {
      "description": "Fixed server vocabulary keyed by code (see README); never exception text.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f]*$"
    }
  }
}
