{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tether.invalid/lecture.v1/transcript.partial.schema.json",
  "title": "transcript.partial",
  "description": "Ephemeral event: seq is null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "sessionId",
    "seq",
    "ts",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "const": "transcript.partial"
    },
    "sessionId": {
      "$ref": "common.schema.json#/$defs/sessionId"
    },
    "seq": {
      "type": "null"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "revision",
        "startMs",
        "text"
      ],
      "properties": {
        "segmentId": {
          "$ref": "common.schema.json#/$defs/segmentId"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "startMs": {
          "$ref": "common.schema.json#/$defs/ms"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "speaker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}
