# Copy to .env for local dev. NEVER commit .env or real values (SEC-019).
# Values below are placeholders only.

# --- Local PostgreSQL (docker-compose.yml) - DEV ONLY, not for any shared/prod env ---
POSTGRES_USER=cc_dev
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=college_companion_dev
POSTGRES_PORT=5432

# --- Providers: mock by default so no paid calls occur ---
STT_PROVIDER=mock
CLAUDE_PROVIDER=mock
GOOGLE_DOCS_PROVIDER=mock

# --- Real provider keys: leave empty. Prefer `dotnet user-secrets` for the API. ---
ANTHROPIC_API_KEY=
STT_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
